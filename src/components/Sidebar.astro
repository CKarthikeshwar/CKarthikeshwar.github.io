---
const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
];

// TODO: replace with real profile URLs when ready.
const socials = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'X', href: '#' },
  { label: 'Instagram', href: '#' },
];
---

<header
  class="lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-[360px] lg:flex-col lg:justify-between px-8 py-12 lg:px-16 lg:py-24"
>
  <div>
    <h1 class="text-3xl font-semibold text-text-primary">
      <a href="/">Chimirela Karthikeshwar</a>
    </h1>
    <p class="mt-3 text-lg text-text-primary">Math &amp; Computing, IISc Bengaluru</p>
    <p class="mt-4 max-w-xs text-sm leading-relaxed">
      I like proving things correct, and occasionally breaking neural networks to understand them.
    </p>

    <nav class="mt-8 lg:mt-12">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-widest lg:block lg:space-y-4">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="text-text-secondary transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <ul class="mt-10 flex gap-5 lg:mt-0">
    {socials.map((social) => (
      <li>
        <a
          href={social.href}
          class="text-text-secondary transition-colors hover:text-accent"
          aria-label={social.label}
        >
          {social.label}
        </a>
      </li>
    ))}
  </ul>
</header>
