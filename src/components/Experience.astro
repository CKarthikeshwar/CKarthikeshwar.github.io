---
const roles = [
  {
    title: 'Formal Verification Intern · Emergence AI',
    dates: 'May 2026 — Jul 2026',
    description:
      'Applied formal verification techniques (Lean 4 / Mathlib) to prove safety-critical correctness guarantees for a 2D physics engine — glitch-free collision resolution and anti-tunneling — using exact rational arithmetic and Separating-Axis-Theorem-based collision detection.',
    tags: ['Lean 4', 'Mathlib', 'Formal Verification', 'Theorem Proving'],
  },
];
---

<section id="experience" class="mt-20 scroll-mt-24">
  <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">Experience</h2>
  <ul class="mt-6 space-y-10">
    {roles.map((role) => (
      <li>
        <p class="font-mono text-xs text-text-muted">{role.dates}</p>
        <h3 class="mt-1 font-medium text-text-primary">{role.title}</h3>
        <p class="mt-2 leading-relaxed">{role.description}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {role.tags.map((tag) => (
            <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-accent">
              {tag}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>
