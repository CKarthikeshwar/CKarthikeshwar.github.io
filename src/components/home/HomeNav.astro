---

<div class="t-fade-up flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
  <div class="flex items-center justify-between lg:contents">
    <span class="mono text-[12px] sm:text-[13px]" style="color: var(--t-text2);">
      user<span style="color: var(--t-accent);">@</span>ck<span style="color: var(--t-muted);">:~$</span>
    </span>
    <ul class="flex gap-2 lg:order-3" style="list-style: none; margin: 0; padding: 0;">
      {socials.map((s) => (
        <li>
          <a href={s.href} aria-label={s.label} class="t-icon-btn" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <nav class="t-nav-pills lg:order-2" aria-label="Section navigation">
    {navLinks.map((link, i) => (
      <a
        href={`#${link.id}`}
        class="t-navpill"
        data-navpill={link.id}
        aria-current={i === 0 ? 'true' : 'false'}
      >
        {link.label}
      </a>
    ))}
  </nav>
</div>
