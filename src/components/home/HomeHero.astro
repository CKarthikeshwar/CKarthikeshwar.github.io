---
---

<div
  id="about"
  class="mt-8 grid gap-4 lg:mt-14 lg:grid-cols-[1fr_380px] lg:items-start lg:gap-12"
>
  <div
    class="t-glass t-fade-up order-2 px-5 py-6 sm:px-7 sm:py-7 lg:order-1 lg:px-10 lg:py-9"
    style="background: rgba(255,255,255,0.035);"
  >
    <p class="mono t-prompt-row text-[13px] sm:text-sm">
      <span>$</span><span class="mono t-type1">whoami --full</span>
    </p>
    <h1
      class="mono t-name-reveal mt-3 font-bold sm:mt-4 lg:mt-[18px]"
      style="
        margin: 0;
        line-height: 1.05;
        letter-spacing: -0.02em;
        color: var(--t-text);
        white-space: nowrap;
        font-size: clamp(1.75rem, 10.5cqw, 4.5rem);
      "
    >
      C.Karthikeshwar<span class="t-cursor" aria-hidden="true"></span>
    </h1>
    <p class="mono t-prompt-row text-[13px] sm:text-sm" style="margin-top: 24px;">
      <span>$</span><span class="mono t-type2">cat role.txt</span>
    </p>
    <p
      class="t-role-line-reveal mt-2.5 lg:mt-3.5"
      style="margin: 0; font-size: 14px; line-height: 1.65; color: var(--t-text2);"
    >
      &gt; Mathematics &amp; Computing, IISc Bengaluru
    </p>
  </div>

  <div
    class="t-glass t-fade-up order-1 p-2.5 lg:order-2 lg:p-3.5"
    style="background: rgba(255,255,255,0.045);"
  >
    <img
      src="/ck.jpg"
      alt="Portrait of Chimirela Karthikeshwar"
      width="800"
      height="800"
      style="
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 12px;
        display: block;
        box-shadow: 0 0 0 1px var(--t-border);
      "
    />
  </div>
</div>
