---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeNav from '../components/home/HomeNav.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeExperience from '../components/home/HomeExperience.astro';
import HomeProjects from '../components/home/HomeProjects.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import ConstellationBackground from '../components/ConstellationBackground.astro';
---

<HomeLayout title="C.Karthikeshwar">
  <div class="terminal">
    <ConstellationBackground />
    <div class="relative z-10 mx-auto max-w-[1280px] px-5 py-8 sm:px-8 sm:py-10 lg:px-[60px] lg:py-16">
      <HomeNav />
      <HomeHero />
      <HomeExperience />
      <HomeProjects />
      <HomeFooter />
    </div>
  </div>
</HomeLayout>

<script>
  // --- Collapsible "$ ls ..." sections -------------------------------
  const toggles = document.querySelectorAll<HTMLButtonElement>('[aria-controls]');
  toggles.forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls')!);
    if (!panel) return;
    // Switch from the no-JS "max-height: none" default to a measured px
    // value so the collapse transition has something to animate from/to.
    panel.style.maxHeight = `${panel.scrollHeight}px`;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        panel.style.maxHeight = `${panel.scrollHeight}px`;
        requestAnimationFrame(() => {
          panel.style.maxHeight = '0px';
          panel.dataset.collapsed = 'true';
        });
      } else {
        panel.dataset.collapsed = 'false';
        panel.style.maxHeight = `${panel.scrollHeight}px`;
      }
    });
  });

  window.addEventListener('resize', () => {
    toggles.forEach((btn) => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!);
      if (!panel || panel.dataset.collapsed === 'true') return;
      panel.style.maxHeight = `${panel.scrollHeight}px`;
    });
  });

  // --- Scroll-spy nav pills -------------------------------------------
  const sections = ['about', 'experience', 'projects', 'dump']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  const pills = document.querySelectorAll<HTMLAnchorElement>('[data-navpill]');

  if (sections.length && pills.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      pills.forEach((pill) => {
        pill.setAttribute('aria-current', pill.dataset.navpill === id ? 'true' : 'false');
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
  }

</script>
