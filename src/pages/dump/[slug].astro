---
import { getCollection, render } from 'astro:content';
import DumpLayout from '../../layouts/DumpLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<DumpLayout title={`${post.data.title} — Chimirela Karthikeshwar`}>
  <a href="/dump" class="mono t-toggle" style="margin: 0 0 28px;">
    <span>&larr; $ cd dump/</span>
  </a>
  <article>
    <p class="mono" style="margin: 0; font-size: 11px; color: var(--t-muted);">
      {post.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </p>
    <h1 style="margin: 8px 0 0; font-size: 28px; font-weight: 700; color: var(--t-text);">
      {post.data.title}
    </h1>
    {post.data.tags.length > 0 && (
      <div style="margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px;">
        {post.data.tags.map((tag) => (
          <span class="t-chip">{tag}</span>
        ))}
      </div>
    )}
    <div class="t-post-content" style="margin-top: 32px; color: var(--t-text2);">
      <Content />
    </div>
  </article>
</DumpLayout>
