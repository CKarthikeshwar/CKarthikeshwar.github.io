---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-v1.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Archived snapshot of a previous version of this site." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <title>Chimirela Karthikeshwar (v1 archive)</title>
  </head>
  <body class="min-h-screen">
    <div class="bg-glow" aria-hidden="true"></div>

    <header
      class="lg:fixed lg:inset-y-0 lg:left-0 lg:flex lg:w-[360px] lg:flex-col lg:justify-between px-8 py-12 lg:px-16 lg:py-24"
    >
      <div>
        <img
          src="/ck.jpg"
          alt="Portrait of Chimirela Karthikeshwar"
          class="mx-auto block h-32 w-32 rounded-full object-cover ring-1 ring-border sm:h-40 sm:w-40 lg:mx-0 lg:h-48 lg:w-48"
        />
        <h1 class="mt-6 text-3xl font-semibold text-text-primary">
          <a href="/v1">Chimirela Karthikeshwar</a>
        </h1>
        <p class="mt-3 text-lg text-text-primary">Mathematics &amp; Computing, IISc Bengaluru</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed">
          I like to overanalyze stuff, and watch anime.
        </p>

        <nav class="mt-8 lg:mt-12">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-widest lg:block lg:space-y-4">
            {navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-text-secondary transition-colors hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <ul class="mt-10 flex gap-5 lg:mt-0">
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="block text-text-secondary transition-colors hover:text-accent"
              aria-label={social.label}
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true" focusable="false">
                <path d={social.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </header>

    <main class="lg:ml-[360px] px-8 py-12 lg:px-16 lg:py-24">
      <div class="max-w-2xl lg:mx-auto lg:max-w-3xl">
        <section id="about" class="scroll-mt-24">
          <p class="leading-relaxed">
            Hi, I'm Karthikeshwar — I study Mathematics and Computing at the Indian Institute of Science,
            Bengaluru. I like anything mathematical and logic related which includes a range of stuff like
            Probability &amp; Statistics, Discrete Mathematics and Neural Networks.
          </p>
          <p class="mt-4 leading-relaxed">
            Most recently, I spent a summer at Emergence AI applying formal verification to a 2D physics
            engine — proving collision resolution and anti-tunneling guarantees using exact rational
            arithmetic. Outside of that, I've worked on adversarial robustness in vision models and built
            ML pipelines for real-world problems like traffic congestion in Bengaluru.
          </p>
        </section>

        <section id="experience" class="mt-20 scroll-mt-24">
          <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">Experience</h2>
          <ul class="mt-6 space-y-10">
            {roles.map((role) => (
              <li>
                <p class="font-mono text-xs text-text-muted">{role.dates}</p>
                <h3 class="mt-1 font-medium text-text-primary">{role.title}</h3>
                <p class="mt-2 leading-relaxed">{role.description}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="projects" class="mt-20 scroll-mt-24">
          <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">Projects</h2>
          <ul class="mt-6 space-y-10">
            {projects.map((project) => (
              <li>
                <p class="font-mono text-xs text-text-muted">{project.dates}</p>
                <h3 class="mt-1 font-medium text-text-primary">
                  {project.href ? (
                    <a href={project.href} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent">
                      {project.title}
                      <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7M7 7h10v10" />
                      </svg>
                    </a>
                  ) : (
                    project.title
                  )}
                </h3>
                <p class="mt-2 leading-relaxed">{project.description}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="skills" class="mt-20 scroll-mt-24">
          <h2 class="font-mono text-xs uppercase tracking-widest text-text-muted">Skills</h2>
          <dl class="mt-6 space-y-4">
            {skillGroups.map((group) => (
              <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                <dt class="w-40 shrink-0 font-mono text-xs text-text-muted">{group.label}</dt>
                <dd>{group.items.join(' · ')}</dd>
              </div>
            ))}
          </dl>
        </section>

        <footer class="mt-20 pb-12">
          <a
            href="/dump"
            class="inline-block rounded-full border border-accent px-6 py-3 font-mono text-xs uppercase tracking-widest text-accent transition-colors hover:bg-accent hover:text-bg"
          >
            Dump &rarr;
          </a>
        </footer>
      </div>
    </main>
  </body>
</html>
