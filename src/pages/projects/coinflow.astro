---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="CoinFlow — Chimirela Karthikeshwar"
  description="CoinFlow is an Android expense tracker that reads your bank SMS so you don't have to type a single transaction. 100% on-device, zero network calls."
  bleed
>
  <div class="cf">
    <p class="cf-crumb">
      <a href="/#projects">Projects</a>
      <span aria-hidden="true">/</span>
      CoinFlow
    </p>

    <!-- ============ HERO ============ -->
    <section class="cf-hero">
      <div class="cf-wrap">
        <div class="cf-brand">
          <!-- TODO: swap for the real app icon once it exists -->
          <div class="cf-icon-slot" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 16l4.5-6L12 14l3-4 5 6"/><circle cx="12" cy="12" r="9"/></svg>
          </div>
          <span class="cf-wordmark">CoinFlow</span>
        </div>

        <h1 class="cf-pitch">Expense tracking that reads your bank SMS so you don't have to.</h1>
        <p class="cf-sub">
          You don't type transactions — your SMS does. Every debit and credit alert becomes a
          one-tap notification. <b>100% on-device, zero network calls</b> — nothing you spend
          ever leaves your phone.
        </p>

        <div class="cf-flow">
          <span class="cf-flow__step">Transaction happens</span><span class="cf-flow__arrow">→</span>
          <span class="cf-flow__step">SMS arrives</span><span class="cf-flow__arrow">→</span>
          <span class="cf-flow__step">CoinFlow detects it</span><span class="cf-flow__arrow">→</span>
          <span class="cf-flow__step">Notification</span><span class="cf-flow__arrow">→</span>
          <span class="cf-flow__step cf-flow__step--last">Tap to confirm</span>
        </div>

        <div class="cf-btn-row">
          <a class="cf-btn cf-btn--primary" href="https://github.com/CKarthikeshwar/coinflow/releases/latest/download/coinflow.apk">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
            Download APK
          </a>
          <a class="cf-btn cf-btn--ghost" href="https://github.com/CKarthikeshwar/coinflow">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
            View source on GitHub
          </a>
        </div>

        <div class="cf-phoneslot">
          <div>
            <div class="cf-phone">
              <span class="cf-phone__notch" aria-hidden="true"></span>
              <div class="cf-phone__screen">
                <div class="cf-lock__time">9:41</div>
                <div class="cf-lock__date">Thursday, 21 August</div>
                <div class="cf-lock__stack">
                  <div class="cf-notif">
                    <div class="cf-notif__head">
                      <span class="cf-notif__app">₹</span>
                      <span class="cf-notif__app-name">CoinFlow</span>
                      <span>· now</span>
                    </div>
                    <div class="cf-notif__title">₹450 debited</div>
                    <div class="cf-notif__body">Swiggy · UPI</div>
                    <div class="cf-notif__actions">
                      <button class="cf-notif__action cf-notif__action--primary" type="button">Save</button>
                      <button class="cf-notif__action" type="button">Add</button>
                      <button class="cf-notif__action cf-notif__action--muted" type="button">Discard</button>
                    </div>
                  </div>
                  <div class="cf-notif cf-notif--collapsed">
                    <div class="cf-notif__head">
                      <span class="cf-notif__app">✉</span>
                      <span class="cf-notif__app-name">Messages</span>
                      <span>· 8m</span>
                    </div>
                    <div class="cf-notif__title">HDFC Bank: Rs.450.00 debited via UPI…</div>
                  </div>
                </div>
              </div>
            </div>
            <p class="cf-phone__caption">Known account → one-tap &ldquo;Save&rdquo;, no form to fill</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROBLEM / PRINCIPLE ============ -->
    <section class="cf-section">
      <div class="cf-wrap">
        <p class="cf-eyebrow">Why it works this way</p>
        <p class="cf-quote">The user should record as little as possible.</p>
        <p class="cf-quote-attr">— CoinFlow's core design principle</p>

        <div class="cf-contrast">
          <div class="cf-contrast__card">
            <p class="cf-contrast__head">Manual expense apps</p>
            <ul>
              <li>Open the app, type the amount</li>
              <li>Pick a category from a menu, every time</li>
              <li>Easy to forget mid-day → gaps in the ledger</li>
              <li>Cash and card entries look the same effort</li>
            </ul>
          </div>
          <div class="cf-contrast__card cf-contrast__card--cf">
            <p class="cf-contrast__head">CoinFlow</p>
            <ul>
              <li>SMS arrives → CoinFlow already parsed it</li>
              <li>Notification shows amount, merchant, account</li>
              <li>Known account → tap &ldquo;Save&rdquo;, done</li>
              <li>New account → quick review sheet, pre-filled</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FEATURES ============ -->
    <section class="cf-section">
      <div class="cf-wrap cf-wrap--wide">
        <p class="cf-eyebrow">What it does</p>
        <h2 class="cf-title">Everything the ledger needs, none of the typing</h2>

        <div class="cf-feat-grid">
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
            <h3>Automatic SMS detection</h3>
            <p>Reads incoming bank/UPI SMS on-device, works out the amount, direction, account, and payment method, and posts a notification — no app switching required.</p>
          </div>
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
            <h3>One-tap confirm &amp; account memory</h3>
            <p>Confirmed this account before? The next notification auto-fills the same category and note. No ML, no keyword guessing — just what you actually picked last time.</p>
            <span class="cf-feat__note">deliberate, not smart</span>
          </div>
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M2 8h20M2 8v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8M2 8l3-5h14l3 5"/></svg></div>
            <h3>Manual entry</h3>
            <p>Cash payments and anything SMS can't catch get added by hand — the same sheet used for confirming, just started from a blank slate.</p>
          </div>
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4Z"/><path d="M3 12l9 4 9-4M3 17l9 4 9-4"/></svg></div>
            <h3>Categories, your way</h3>
            <p>9 defaults plus an Uncategorized bucket — create, rename, reorder, or delete categories to match how you actually spend.</p>
          </div>
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg></div>
            <h3>Analytics</h3>
            <p>Running balance, income vs. spending with month-over-month change, a category breakdown, a daily spend chart, and your biggest expenses.</p>
          </div>
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M21 8V5a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v3"/><path d="M3 8l2.2 9A2 2 0 0 0 7.2 19h9.6a2 2 0 0 0 2-1.6L21 8"/><path d="M9 12h6"/></svg></div>
            <h3>Review Queue</h3>
            <p>An inbox of every SMS-detected suggestion still waiting on you — confirm or dismiss at your own pace, nothing is written until you say so.</p>
          </div>
          <div class="cf-feat">
            <div class="cf-feat__ic"><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg></div>
            <h3>Export / wipe data</h3>
            <p>Take everything out as JSON or CSV via the OS share sheet, or wipe the app back to a fresh install. Your data, your call.</p>
          </div>
        </div>

        <!-- TODO: replace these three slots with real device screenshots (Home, Analytics, Review Queue) -->
        <div class="cf-shot-strip" aria-hidden="true">
          <div class="cf-shot-slot"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg><span>Home</span></div>
          <div class="cf-shot-slot"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg><span>Analytics</span></div>
          <div class="cf-shot-slot"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg><span>Review Queue</span></div>
        </div>
        <p class="cf-shot-note">Device screenshots — coming soon.</p>
      </div>
    </section>

    <!-- ============ PRIVACY ============ -->
    <section class="cf-section cf-privacy">
      <div class="cf-wrap cf-wrap--wide">
        <p class="cf-eyebrow">Privacy</p>
        <h2 class="cf-title">No data leaves your phone</h2>
        <div class="cf-privacy__grid">
          <div class="cf-privacy__badge">
            <svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2.4"/><path d="M11 18h2"/><path d="M3 3l18 18"/></svg>
          </div>
          <ul>
            <li>
              <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
              <span><b>Zero network requests by default.</b> CoinFlow has no accounts, no login, no backend — every SMS parse, every notification, every chart is computed on-device.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
              <span><b>Crash reporting is opt-in, and scrubbed.</b> Off unless you turn it on in Settings — and even then, reports are stripped of anything resembling money, an account, or a UPI id before they're sent.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
              <span><b>Raw SMS text is never stored, ever.</b> Only the fields parsed out of it — amount, direction, account, method — make it into the database.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ HOW IT'S BUILT ============ -->
    <section class="cf-section">
      <div class="cf-wrap cf-wrap--wide">
        <p class="cf-eyebrow">How it's built</p>
        <h2 class="cf-title">The stack, for other developers</h2>

        <div class="cf-stack-card">
          <div class="cf-stack-row"><span class="cf-stack-row__k">Framework</span><span class="cf-stack-row__v">Expo SDK 57 · React Native 0.86 · React 19 · <code>TypeScript</code></span></div>
          <div class="cf-stack-row"><span class="cf-stack-row__k">Navigation</span><span class="cf-stack-row__v"><code>expo-router</code>, file-based</span></div>
          <div class="cf-stack-row"><span class="cf-stack-row__k">Database</span><span class="cf-stack-row__v"><code>expo-sqlite</code> via <code>Drizzle ORM</code></span></div>
          <div class="cf-stack-row"><span class="cf-stack-row__k">UI state</span><span class="cf-stack-row__v"><code>Zustand</code></span></div>
          <div class="cf-stack-row"><span class="cf-stack-row__k">SMS access</span><span class="cf-stack-row__v">Custom native Kotlin module + a headless JS background task</span></div>
          <div class="cf-stack-row"><span class="cf-stack-row__k">Notifications</span><span class="cf-stack-row__v"><code>expo-notifications</code></span></div>
          <div class="cf-stack-row"><span class="cf-stack-row__k">Charts</span><span class="cf-stack-row__v"><code>d3-shape</code> / <code>d3-scale</code> + <code>react-native-svg</code></span></div>
        </div>

        <p class="cf-eyebrow cf-eyebrow--tight">SMS → notification → transaction</p>
        <div class="cf-flowdiag">
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">SMS arrives</p>
            <p class="cf-flowdiag__sub"><code>SmsReceiver.kt</code> fires — the only code guaranteed to run even if the app is fully closed.</p>
          </div>
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">Headless JS task boots</p>
            <p class="cf-flowdiag__sub">No UI, just enough of the JS engine to run <code>sms-ingest.ts</code>.</p>
          </div>
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">Parse &amp; classify</p>
            <p class="cf-flowdiag__sub">Known sender? Real transaction, not an OTP or promo? Already processed? Three checks before anything is written.</p>
          </div>
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">Suggestion saved, category looked up</p>
            <p class="cf-flowdiag__sub">A pending row is written, and the account's learned category (if any) is attached to it.</p>
          </div>
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">Notification posted</p>
            <p class="cf-flowdiag__sub">Known account → Save / Add / Discard. New account → Add / Discard.</p>
          </div>
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">Transaction written</p>
            <p class="cf-flowdiag__sub">One tap, or a quick review sheet for anything unfamiliar.</p>
          </div>
          <div class="cf-flowdiag__step">
            <span class="cf-flowdiag__dot"></span>
            <p class="cf-flowdiag__label">Every screen updates itself</p>
            <p class="cf-flowdiag__sub">Built on live queries — nothing in the app manually refetches.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CTA BAND ============ -->
    <section class="cf-cta-band">
      <div class="cf-wrap">
        <h2>Try it on your own phone</h2>
        <p>One signed APK, always up to date.</p>
        <div class="cf-btn-row cf-btn-row--center">
          <a class="cf-btn cf-btn--primary" href="https://github.com/CKarthikeshwar/coinflow/releases/latest/download/coinflow.apk">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
            Download APK
          </a>
          <a class="cf-btn cf-btn--ghost" href="https://github.com/CKarthikeshwar/coinflow">View source on GitHub</a>
        </div>
        <p class="cf-cta-band__note">Android only — needs a real device for SMS access, not Expo Go.</p>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="cf-foot">
      <div class="cf-wrap">
        <div class="cf-foot__links">
          <a href="https://github.com/CKarthikeshwar/coinflow">GitHub</a>
          <a href="https://github.com/CKarthikeshwar/coinflow/releases/latest/download/coinflow.apk">Download APK</a>
          <a href="/#projects">← Back to portfolio</a>
        </div>
        <p class="cf-foot__meta">CoinFlow — built &amp; maintained by Chimirela Karthikeshwar</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");

  .cf {
    --cf-bg: #0d0e14;
    --cf-bg-top: #1b2238;
    --cf-surface: #16171d;
    --cf-surface-2: #1c1e26;
    --cf-surface-3: #262832;
    --cf-hairline: #2b2d38;

    --cf-text: #f5f5f6;
    --cf-text-2: #9a9aa1;
    --cf-text-3: #85858c;

    --cf-primary: #ffffff;
    --cf-primary-ink: #0b0b0c;

    --cf-r-card: 24px;
    --cf-r-ctl: 14px;
    --cf-r-pill: 999px;

    --cf-shadow-card: 0 8px 24px rgba(0, 0, 0, 0.5), 0 1px 4px rgba(0, 0, 0, 0.4);
    --cf-card-edge: 1px solid rgba(255, 255, 255, 0.05);
    --cf-shadow-pop: 0 12px 34px rgba(0, 0, 0, 0.6), 0 3px 10px rgba(0, 0, 0, 0.45);

    background: var(--cf-bg);
    color: var(--cf-text);
    font-family: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.6;
  }

  .cf h1, .cf h2, .cf h3, .cf .cf-money, .cf-wordmark, .cf-quote, .cf-lock__time, .cf-notif__title {
    font-family: "Manrope", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }

  .cf a { color: inherit; }
  .cf ::selection { background: rgba(255, 255, 255, 0.22); }

  .cf-crumb {
    max-width: 820px;
    margin: 0 auto;
    padding: 28px 22px 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--cf-text-3);
    display: flex;
    gap: 8px;
  }
  .cf-crumb a { color: var(--cf-text-2); text-decoration: none; }
  .cf-crumb a:hover { color: var(--cf-text); }

  .cf-wrap { max-width: 640px; margin: 0 auto; padding: 0 22px; }
  .cf-wrap--wide { max-width: 820px; }

  .cf-section { padding: 68px 0; }
  .cf-section + .cf-section,
  .cf-cta-band { border-top: 1px solid var(--cf-hairline); }

  .cf-eyebrow {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--cf-text-3);
    margin: 0 0 12px;
  }
  .cf-eyebrow--tight { margin-top: 44px; }

  .cf-title {
    font-size: clamp(21px, 3vw, 25px);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 30px;
    text-wrap: balance;
  }

  /* ---- buttons ---- */
  .cf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: var(--cf-r-ctl);
    padding: 13px 20px;
    font: inherit;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .cf a.cf-btn--primary {
    background: var(--cf-primary);
    color: var(--cf-primary-ink);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }
  .cf a.cf-btn--primary:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4); }
  .cf a.cf-btn--ghost { background: var(--cf-surface-2); color: var(--cf-text); }
  .cf a.cf-btn--ghost:hover { background: var(--cf-surface-3); }
  .cf-btn-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
  .cf-btn-row--center { justify-content: center; margin-bottom: 0; }

  /* ================= HERO ================= */
  .cf-hero {
    padding: 44px 0 60px;
    background: radial-gradient(135% 46% at 50% -10%, var(--cf-bg-top) 0%, #0e0f18 42%, #090a0d 100%);
  }
  .cf-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 36px; }
  .cf-icon-slot {
    width: 46px; height: 46px; flex: none;
    border-radius: 13px;
    border: 1.5px dashed var(--cf-hairline);
    display: grid; place-items: center;
    color: var(--cf-text-3);
  }
  .cf-icon-slot svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .cf-wordmark { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }

  .cf-pitch {
    font-size: clamp(28px, 4.4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.022em;
    line-height: 1.15;
    text-wrap: balance;
    margin: 0 0 16px;
    max-width: 15ch;
  }
  .cf-sub {
    font-size: 15.5px;
    color: var(--cf-text-2);
    line-height: 1.6;
    max-width: 48ch;
    margin: 0 0 30px;
  }
  .cf-sub b { color: var(--cf-text); font-weight: 600; }

  .cf-flow {
    display: flex; flex-wrap: wrap; align-items: center;
    margin: 0 0 34px;
    padding: 16px 18px;
    background: var(--cf-surface);
    border: var(--cf-card-edge);
    border-radius: var(--cf-r-card);
    box-shadow: var(--cf-shadow-card);
  }
  .cf-flow__step { font-size: 12.5px; font-weight: 600; color: var(--cf-text-2); padding: 6px 4px; white-space: nowrap; }
  .cf-flow__step--last { color: var(--cf-text); }
  .cf-flow__arrow { color: var(--cf-text-3); padding: 0 8px; font-size: 13px; flex: none; }

  .cf-phoneslot { display: flex; justify-content: center; margin-top: 48px; }
  .cf-phone {
    position: relative;
    width: 272px; aspect-ratio: 272 / 560;
    border-radius: 38px; padding: 10px;
    background: #050508;
    box-shadow: var(--cf-shadow-pop), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .cf-phone__notch {
    position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
    width: 74px; height: 20px; border-radius: 12px; background: #050508;
    z-index: 2;
  }
  .cf-phone__screen {
    height: 100%; border-radius: 29px; overflow: hidden;
    background: radial-gradient(125% 60% at 50% -4%, var(--cf-bg-top) 0%, var(--cf-bg) 62%);
    display: flex; flex-direction: column; align-items: center;
    padding: 38px 14px 20px; position: relative;
  }
